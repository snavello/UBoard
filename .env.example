# Copiar a .env y completar. El .env NO se commitea.

# Postgres del catalogo. En desarrollo apunta al contenedor de docker-compose
# (puerto 5433 en el host para convivir con el 5432 de Mi Trabajo).
DATABASE_URL=postgresql+psycopg://uboard:uboard-dev-local@localhost:5433/uboard_dev

# Base separada para los tests de API (mismo contenedor, creada por
# docker/postgres-init.sql). Los tests fallan si apunta a la misma base que
# DATABASE_URL, a proposito.
DATABASE_URL_TEST=postgresql+psycopg://uboard:uboard-dev-local@localhost:5433/uboard_test

# Secreto para firmar los JWT de sesion. Cambiar en cualquier entorno real.
SECRETO_SESION=cambiar-este-secreto-en-produccion

# Minutos sin actividad antes de que venza la sesion (renovacion deslizante).
MINUTOS_INACTIVIDAD=15

# Raiz del almacen local de archivos (Parquet y subidas). En Docker es un volumen.
RUTA_ALMACEN=datos/almacen

# Claude (fase 2): clave de la API de Anthropic. Sin clave, la inferencia
# corre solo con heuristicas. MODELO_CLAUDE, FILAS_MUESTRA_LLM (filas por
# tabla que viajan a Claude) y ENVIAR_MUESTRA_LLM (false = solo perfil, sin
# datos) son opcionales.
ANTHROPIC_API_KEY=
# MODELO_CLAUDE=claude-sonnet-5
# FILAS_MUESTRA_LLM=30
# ENVIAR_MUESTRA_LLM=true

# local | pruebas | demo | prod. En local y pruebas la UI muestra el distintivo.
ENTORNO=local
